# Supabase — Configurações do projeto (Settings > API no painel do Supabase)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-publica
SUPABASE_SERVICE_KEY=sua-service-role-key-SECRETA-nunca-expor-no-frontend

# Groq — console.groq.com, tier gratuito
GROQ_API_KEY=sua-chave-groq
# 'llama-3.3-70b-versatile' saiu do catálogo em algumas contas (dava 404).
# Confira seu catálogo disponível em GET https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-120b
# Modelo com visão usado pra identificar foto de produto no Estoque
# (marca/descrição/validade). Confira modelos com visão disponíveis em
# console.groq.com/docs/vision -- catálogo já mudou antes, fique de olho.
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Criptografia de dado sensível (ficha técnica do cliente) em camada de
# aplicação -- ver docs/blueprint-backend-salonos.md, seção 4.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRYPTO_KEY=64-caracteres-hex-gerados-por-voce-nunca-comitar-o-valor-real

# Evolution API (WhatsApp self-hosted) — ver docs/README-fase1.md, seção "Próximos passos"
# Multi-tenant: um deploy só, uma instância por salão (nome "salon_{estabelecimento_id}",
# criada sob demanda quando o dono conecta -- ver src/lib/evolution-api.js). Não existe
# mais uma EVOLUTION_INSTANCE fixa, só a URL do deploy e a chave de API.
EVOLUTION_API_URL=https://sua-instancia-evolution.up.railway.app
EVOLUTION_API_KEY=sua-chave-global-da-evolution-api

# Porta local (Railway define isso automaticamente em produção)
PORT=3000

# URL pública de onde este servidor é acessível (serve public/ como estático)
# -- usada para montar o link de avaliação enviado por WhatsApp depois de
# fechar uma comanda. Em produção é a URL do Railway.
PUBLIC_BASE_URL=http://localhost:3000

# Segredo compartilhado da rota GET /admin/hub-metricas (ver src/routes/
# hub-metricas.js) -- quem chama é o backend do hub OmniFlow Studio,
# autenticado por header X-Hub-Key em vez de login. Precisa ser IDÊNTICO
# ao valor configurado em SALONOS_HUB_KEY no .env do omniflow-studio.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HUB_METRICS_KEY=64-caracteres-hex-gerados-por-voce-nunca-comitar-o-valor-real
