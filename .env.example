# Supabase — Configurações do projeto (Settings > API no painel do Supabase)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-publica
SUPABASE_SERVICE_KEY=sua-service-role-key-SECRETA-nunca-expor-no-frontend

# Groq — console.groq.com, tier gratuito
GROQ_API_KEY=sua-chave-groq

# Porta local (Railway define isso automaticamente em produção)
PORT=3000
